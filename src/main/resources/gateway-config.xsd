<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for WebSocket Gateway configuration.

  Connections are declared as top-level labeled elements (<websocket-server>,
  <tcp-client>).  Data flow is configured separately via <forward> rules, each
  specifying a unidirectional path from one labeled connection to another.

  Fan-out is supported: a single source may forward to multiple targets by
  listing multiple <forward from="source" to="..."/> rules.

  Namespace: http://github.com/web-socket-gateway/config/v1
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://github.com/web-socket-gateway/config/v1"
           xmlns:tns="http://github.com/web-socket-gateway/config/v1"
           elementFormDefault="qualified"
           version="2.0">

    <!-- ================================================================== -->
    <!-- Root element                                                         -->
    <!-- ================================================================== -->
    <xs:element name="gateway-config" type="tns:GatewayConfigType">
        <xs:annotation>
            <xs:documentation>
                Root element. Contains any mix of connection declarations
                (websocket-server, tcp-client) and unidirectional forward rules.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:complexType name="GatewayConfigType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="websocket-server" type="tns:WebSocketServerType"/>
            <xs:element name="tcp-client"       type="tns:TcpClientType"/>
            <xs:element name="forward"          type="tns:ForwardType"/>
        </xs:choice>
    </xs:complexType>

    <!-- ================================================================== -->
    <!-- WebSocket server endpoint                                            -->
    <!-- ================================================================== -->
    <xs:complexType name="WebSocketServerType">
        <xs:annotation>
            <xs:documentation>
                Configures a Netty WebSocket server that browser / JS clients
                connect to.

                label         - Unique name used in forward rules to reference
                                this endpoint (required).
                bind-address  - IP address (or hostname) to listen on.
                                Use 0.0.0.0 to accept connections on all
                                network interfaces (default).
                port          - TCP port to listen on (required).
                path          - WebSocket upgrade path, e.g. /ws (default).
                max-frame-bytes - Maximum WebSocket frame payload size in bytes.
                                  Defaults to 65536 (64 KiB).
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="label"           type="xs:string"          use="required"/>
        <xs:attribute name="bind-address"    type="xs:string"          default="0.0.0.0"/>
        <xs:attribute name="port"            type="tns:PortType"       use="required"/>
        <xs:attribute name="path"            type="xs:string"          default="/ws"/>
        <xs:attribute name="max-frame-bytes" type="xs:positiveInteger" default="65536"/>
    </xs:complexType>

    <!-- ================================================================== -->
    <!-- TCP client endpoint                                                  -->
    <!-- ================================================================== -->
    <xs:complexType name="TcpClientType">
        <xs:annotation>
            <xs:documentation>
                Configures an outbound TCP client connection.

                label                   - Unique name used in forward rules to
                                          reference this endpoint (required).
                host                    - Remote hostname or IP address (required).
                port                    - Remote TCP port (required).
                reconnect-delay-seconds - Seconds to wait before attempting to
                                          reconnect after a lost connection.
                                          Defaults to 5.
                connect-timeout-seconds - Maximum time (seconds) to wait for the
                                          initial TCP handshake to complete.
                                          Defaults to 10.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="label"                   type="xs:string"          use="required"/>
        <xs:attribute name="host"                    type="xs:string"          use="required"/>
        <xs:attribute name="port"                    type="tns:PortType"       use="required"/>
        <xs:attribute name="reconnect-delay-seconds" type="xs:positiveInteger" default="5"/>
        <xs:attribute name="connect-timeout-seconds" type="xs:positiveInteger" default="10"/>
    </xs:complexType>

    <!-- ================================================================== -->
    <!-- Unidirectional forwarding rule                                       -->
    <!-- ================================================================== -->
    <xs:complexType name="ForwardType">
        <xs:annotation>
            <xs:documentation>
                Declares a unidirectional forwarding rule.  Data arriving at the
                endpoint named by 'from' will be delivered to the endpoint named
                by 'to'.  Multiple rules with the same 'from' achieve fan-out.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="from" type="xs:string" use="required"/>
        <xs:attribute name="to"   type="xs:string" use="required"/>
    </xs:complexType>

    <!-- ================================================================== -->
    <!-- Shared simple types                                                  -->
    <!-- ================================================================== -->
    <xs:simpleType name="PortType">
        <xs:annotation>
            <xs:documentation>Valid TCP/UDP port number: 1–65535.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:int">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="65535"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
