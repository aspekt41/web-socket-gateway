<?xml version="1.0" encoding="UTF-8"?>
<!-- Multiple labeled connections with various forwarding rules. -->
<gateway-config xmlns="http://github.com/web-socket-gateway/config/v1">

    <websocket-server label="ws-alpha" port="9004"/>
    <tcp-client       label="tcp-alpha" host="host-a" port="5003"/>

    <websocket-server label="ws-beta"
                      bind-address="0.0.0.0"
                      port="9005"
                      path="/feed"/>
    <tcp-client       label="tcp-beta"
                      host="host-b"
                      port="5004"
                      reconnect-delay-seconds="10"/>

    <forward from="ws-alpha"  to="tcp-alpha"/>
    <forward from="tcp-alpha" to="ws-alpha"/>
    <forward from="ws-beta"   to="tcp-beta"/>

</gateway-config>
