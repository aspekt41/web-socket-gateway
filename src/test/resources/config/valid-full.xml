<?xml version="1.0" encoding="UTF-8"?>
<gateway-config xmlns="http://github.com/web-socket-gateway/config/v1">
    <bridge name="bridge-one" enabled="true">
        <websocket-server bind-address="127.0.0.1" port="9001" path="/data" max-frame-bytes="32768"/>
        <tcp-client host="192.168.1.100" port="5000" reconnect-delay-seconds="3" connect-timeout-seconds="7"/>
    </bridge>
</gateway-config>
