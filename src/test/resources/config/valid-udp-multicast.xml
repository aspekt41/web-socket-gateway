<?xml version="1.0" encoding="UTF-8"?>
<!-- UDP multicast with all optional attributes explicit. -->
<gateway-config xmlns="http://github.com/web-socket-gateway/config/v1">
    <udp-multicast label="mcast-feed"
                   group="230.0.0.1"
                   port="4001"
                   bind-address="0.0.0.0"
                   network-interface="lo"/>
    <tcp-client label="tcp-sink" host="localhost" port="5050"/>
    <forward from="mcast-feed" to="tcp-sink"/>
    <forward from="tcp-sink"   to="mcast-feed"/>
</gateway-config>
