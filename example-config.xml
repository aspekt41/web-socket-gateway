<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example WebSocket Gateway configuration.

  Validate against: src/main/resources/gateway-config.xsd
  Namespace:        http://github.com/web-socket-gateway/config/v1
-->
<gateway-config xmlns="http://github.com/web-socket-gateway/config/v1">

    <!--
      A single bridge named "market-data":
        - Listens for WebSocket clients on all interfaces, port 8080, at /ws
        - Connects as a TCP client to localhost:9090
    -->
    <bridge name="market-data" enabled="true">

        <websocket-server
            bind-address="0.0.0.0"
            port="8080"
            path="/ws"
            max-frame-bytes="65536"/>

        <tcp-client
            host="localhost"
            port="9090"
            reconnect-delay-seconds="5"
            connect-timeout-seconds="10"/>

    </bridge>

</gateway-config>
